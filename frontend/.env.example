# Frontend (React + Vite). Salin ke `.env.local` (dev) atau `.env.production` (build VPS).
# Variabel VITE_* ditanam ke bundle JS saat build dan TERLIHAT publik:
# jangan pernah menaruh secret/API key di sini.

# Base URL API Laravel (wajib di production).
# Lokal (php artisan serve):  http://127.0.0.1:8000/api/v1/hellom
# Production:                 https://hellomspace.com/api/v1/hellom
VITE_HELLOM_API_BASE=http://127.0.0.1:8000/api/v1/hellom

# URL publik server realtime Socket.IO (bell notifikasi super admin).
# Lokal: http://127.0.0.1:3001 · Production: https://hellomspace.com (Nginx proxy /socket.io → :3001)
# Jika kosong: host dari VITE_HELLOM_API_BASE + port 3001.
VITE_REALTIME_PUBLIC_URL=http://127.0.0.1:3001
