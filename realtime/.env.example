# Realtime server (Node Socket.IO). server.js membaca process.env langsung
# (tidak memuat file .env): set variabel ini lewat PM2 (ecosystem.config.js)
# atau environment shell.

# Port & host tempat server mendengarkan. Nginx mem-proxy /socket.io ke sini.
PORT=3001
HOST=0.0.0.0

# WAJIB sama dengan REALTIME_SERVER_SECRET di backend/.env.
# Isi dengan string acak panjang di production (default "change-me" hanya untuk lokal).
REALTIME_SERVER_SECRET=change-me

# Origin browser yang boleh tersambung (dipisah koma). Kosong = semua origin.
# Production: https://hellomspace.com
REALTIME_ALLOWED_ORIGINS=

# Tolak socket tanpa token dari Laravel (GET /api/v1/hellom/realtime/token).
# false = layar Blade lama (socket anonim, room tenant_*) tetap jalan. Set true setelah UI Blade dipensiunkan.
REALTIME_REQUIRE_AUTH=false
