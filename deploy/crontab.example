# Laravel scheduler for Hellom (install as the web user, e.g. `crontab -u www -e`,
# or aaPanel → Cron → Shell Script, every 1 minute).
#
# Required: subscription expiry/auto-renew (hourly), wallet settlement release,
# and expiry notifications (daily) only run through the scheduler.
# Check it is installed:  crontab -l | grep schedule:run
# See scheduled tasks:    php artisan schedule:list

# Runs as the web user (www), like PHP-FPM, so files it writes stay writable for the site.
* * * * * cd /www/wwwroot/hellomspace.com/backend && sudo -u www php artisan schedule:run >> /dev/null 2>&1

# Daily backup at 02:15 (database + uploads). Set BACKUP_RCLONE_REMOTE for an off-site
# copy; a backup that only lives on the same VPS does not survive losing the VPS.
15 2 * * * cd /www/wwwroot/hellomspace.com && BACKUP_DIR=/www/backup/hellom bash deploy/backup.sh >> /www/backup/hellom/backup.log 2>&1

# Uptime: point an external monitor (UptimeRobot, BetterStack, ...) at
#   https://hellomspace.com/api/health   → 200 = ok, 503 = database/cache/scheduler/queue problem
