APP_NAME=Hellom
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# URL publik SPA React untuk link di email (undangan tim/kasir). Default = APP_URL.
# Production: https://hellomspace.com
# FRONTEND_URL=https://hellomspace.com

# --- Mobile/LAN testing (Vite dev server) ---
# If you want to open the app from a phone on the same Wi‑Fi while running `npm run dev`,
# set these to your PC's LAN IP so the phone can load CSS/JS from the Vite server.
# Example:
# VITE_PORT=5173
# VITE_DEV_SERVER_URL=http://192.168.1.10:5173
# VITE_HMR_HOST=192.168.1.10

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=self_order
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Realtime (Node.js Socket.IO)
REALTIME_ENABLED=true
REALTIME_SERVER_URL=http://127.0.0.1:3001
REALTIME_PUBLIC_URL=http://127.0.0.1:3001
REALTIME_SERVER_SECRET=change-me
REALTIME_TIMEOUT_SECONDS=1

# Payments (Dynamic QRIS provider)
# Midtrans Core API (recommended aggregator for Indonesia)
# MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxx
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Mock billing endpoints (fake top-up/checkout). NEVER true in production.
BILLING_MOCK_ENABLED=false

# ─── CORS ───────────────────────────────────────────────────────────────
# Daftar origin (dipisah koma) yang boleh memanggil /api dari domain lain.
# Production melayani SPA dari origin yang sama, jadi cukup origin dev server.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# ─── Tenancy / domain ───────────────────────────────────────────────────
# Domain global aplikasi (marketing/auth). Default diambil dari host APP_URL.
# Production: hellomspace.com  ·  Lokal: localhost,127.0.0.1
# TENANCY_APP_DOMAIN=hellomspace.com
# TENANCY_APP_DOMAINS=localhost,127.0.0.1
# TENANCY_BASE_DOMAIN=hellomspace.com
# Auth dummy UI Blade lama (password plaintext di config). Selalu false di production.
DUMMY_AUTH_ENABLED=false

# ─── Payment gateway (billing & wallet) ─────────────────────────────────
# Kredensial juga bisa diisi super admin dari dashboard (disimpan terenkripsi di DB);
# nilai di DB diprioritaskan. Callback token WAJIB acak & panjang di production.
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_CALLBACK_TOKEN=
IPAYMU_IS_PRODUCTION=false

XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_IS_PRODUCTION=false
XENDIT_WITHDRAWAL_FEE_FLAT=5000

DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_CALLBACK_TOKEN=
DOKU_IS_PRODUCTION=false
DOKU_PAYMENT_METHOD_TYPES=VIRTUAL_ACCOUNT_BCA,VIRTUAL_ACCOUNT_BANK_MANDIRI,QRIS

# Webhook mock (hanya dev; route-nya tidak aktif). Kosong = ditolak.
MOCK_PAYMENT_WEBHOOK_SECRET=

# ─── Platform wallet & komisi ───────────────────────────────────────────
# Komisi platform (%) per penjualan produk landing page.
PLATFORM_SALE_COMMISSION_PERCENT=5
# Minimal penarikan (IDR) dan jeda settlement (jam, dilewati Sabtu/Minggu).
WALLET_MIN_WITHDRAWAL=100000
WALLET_SETTLEMENT_DELAY_HOURS=24

# ─── AI & integrasi lain ────────────────────────────────────────────────
# Gemini dipakai backend untuk AI assist artikel Insights (tidak pernah ke browser).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GOOGLE_MAPS_API_KEY=
